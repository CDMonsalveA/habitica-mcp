# Copy to .env for local experiments (never commit .env). MCP clients pass these as "env".
HABITICA_USER_ID=
HABITICA_API_TOKEN=
# HABITICA_MCP_MODE=read-only
# HABITICA_MCP_LOG_LEVEL=INFO

# Live contract tests: a dedicated test account, not your personal one
# HABITICA_TEST_USER_ID=
# HABITICA_TEST_API_TOKEN=

# Evals with a Claude subscription: token printed by `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=
