{
  "habitica_create_task": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": false,
      "open_world_hint": true,
      "read_only_hint": false
    },
    "description": "Create a habit, daily, to-do or reward. Tags are given by name.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "checklist": {
          "anyOf": [
            {
              "items": {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dailies and to-dos only: checklist item texts"
        },
        "cost": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rewards only: price in gold (default 10)"
        },
        "create_missing_tags": {
          "default": true,
          "description": "Create tags that do not exist yet",
          "type": "boolean"
        },
        "difficulty": {
          "default": "easy",
          "description": "Affects rewards and damage. Not used for rewards",
          "enum": [
            "trivial",
            "easy",
            "medium",
            "hard"
          ],
          "type": "string"
        },
        "due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "To-dos only: due date (YYYY-MM-DD) in the user's calendar"
        },
        "habit_negative": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Habits only: enable - (default false; set true for bad habits)"
        },
        "habit_positive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Habits only: enable + (default true)"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schedule": {
          "anyOf": [
            {
              "additionalProperties": false,
              "description": "When a daily is due.",
              "properties": {
                "days_of_month": {
                  "anyOf": [
                    {
                      "items": {
                        "maximum": 31,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Monthly only: days of the month it is due"
                },
                "every_x": {
                  "default": 1,
                  "description": "Repeat interval X",
                  "maximum": 366,
                  "minimum": 1,
                  "type": "integer"
                },
                "frequency": {
                  "default": "weekly",
                  "description": "'daily' = every X days; 'weekly' = on chosen weekdays every X weeks; 'monthly' = on chosen days of the month every X months; 'yearly' = every X years",
                  "enum": [
                    "daily",
                    "weekly",
                    "monthly",
                    "yearly"
                  ],
                  "type": "string"
                },
                "start_date": {
                  "anyOf": [
                    {
                      "format": "date",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "First day it can be due (YYYY-MM-DD). Default: today"
                },
                "weekdays": {
                  "anyOf": [
                    {
                      "items": {
                        "enum": [
                          "mon",
                          "tue",
                          "wed",
                          "thu",
                          "fri",
                          "sat",
                          "sun"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Weekly only: days it is due. Default: every day"
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dailies only. Default: due every day starting today"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tag names (or ids)"
        },
        "task_type": {
          "description": "'habit' = repeatable good/bad behavior scored with +/-; 'daily' = recurring task on a schedule; 'todo' = one-off task; 'reward' = custom reward bought with gold",
          "enum": [
            "habit",
            "daily",
            "todo",
            "reward"
          ],
          "type": "string"
        },
        "text": {
          "description": "Task title",
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "text"
      ],
      "type": "object"
    },
    "output_properties": [
      "created_tags",
      "message",
      "status",
      "task"
    ],
    "output_schema_sha256": "00236c73d3178d14b0f1000392542e204cfe029c1847a4820038e3fc6d373e0e",
    "tags": [
      "write"
    ],
    "title": "Habitica: create a task"
  },
  "habitica_delete_task": {
    "annotations": {
      "destructive_hint": true,
      "idempotent_hint": false,
      "open_world_hint": true,
      "read_only_hint": false
    },
    "description": "Permanently delete a task. Without confirm=true it only returns a preview: show it to\nthe user and delete only after they agree.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "default": false,
          "description": "Set to true only after the user explicitly agreed to this irreversible action. When false the tool only returns a preview and changes nothing.",
          "type": "boolean"
        },
        "task": {
          "description": "Task id (preferred), alias, or its text. Partial text works when it matches exactly one task.",
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "task"
      ],
      "type": "object"
    },
    "output_properties": [
      "created_tags",
      "message",
      "status",
      "task"
    ],
    "output_schema_sha256": "00236c73d3178d14b0f1000392542e204cfe029c1847a4820038e3fc6d373e0e",
    "tags": [
      "write"
    ],
    "title": "Habitica: delete a task"
  },
  "habitica_get_overview": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": true,
      "read_only_hint": true
    },
    "description": "Snapshot of the user's Habitica day: character stats (HP, mana, XP, gold, level),\ndailies still due today, overdue / due-today / upcoming to-dos and habits, plus\nwarnings such as a new day that has not started yet. Start here when the user asks\nwhat is pending or how they are doing.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "response_format": {
          "default": "concise",
          "description": "'concise' keeps responses short; 'detailed' adds full notes, checklist items with ids, schedules and dates.",
          "enum": [
            "concise",
            "detailed"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "output_properties": [
      "dailies_completed",
      "dailies_due",
      "dailies_due_total",
      "habits",
      "needs_cron",
      "note",
      "player",
      "rewards",
      "today",
      "todos_due_today",
      "todos_overdue",
      "todos_upcoming",
      "todos_without_due_date",
      "warnings"
    ],
    "output_schema_sha256": "abc59ec9e33670d959b0e59f2fb9762f3c217c6b2a536afb15e524fd33b1ca65",
    "tags": [
      "read"
    ],
    "title": "Habitica: today's overview"
  },
