  "habitica_list_tasks": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": true,
      "read_only_hint": true
    },
    "description": "List the user's tasks with filters. Prefer filters over listing everything;\nreturned ids can be passed to the other habitica_* tools.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "response_format": {
          "default": "concise",
          "description": "'concise' keeps responses short; 'detailed' adds full notes, checklist items with ids, schedules and dates.",
          "enum": [
            "concise",
            "detailed"
          ],
          "type": "string"
        },
        "search": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text contained in the task text or notes"
        },
        "status": {
          "default": "all",
          "description": "'all' = active tasks; 'pending' = dailies due today and to-dos not done; 'due_today' = dailies due today and to-dos due today; 'overdue' = to-dos past their due date; 'completed' = dailies done today and the 30 most recently completed to-dos",
          "enum": [
            "all",
            "pending",
            "due_today",
            "overdue",
            "completed"
          ],
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tag name or id"
        },
        "task_type": {
          "anyOf": [
            {
              "enum": [
                "habit",
                "daily",
                "todo",
                "reward"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only this type of task"
        }
      },
      "type": "object"
    },
    "output_properties": [
      "note",
      "tasks",
      "total_matching",
      "truncated"
    ],
    "output_schema_sha256": "e5a17dbfc043c3228144dd07777187ecc68b1353c5c75d008a21b5603d6dac48",
    "tags": [
      "read"
    ],
    "title": "Habitica: list tasks"
  },
